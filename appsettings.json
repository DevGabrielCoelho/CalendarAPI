{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Npgsql": "placeholder_value"
  },
  "JWT": {
    "Issuer": "placeholder_value",
    "Audience": "placeholder_value",
    "SigninKey": "placeholder_value"
  },
  "Email": {
    "SmtpServer": "placeholder_value",
    "SmtpPort": "placeholder_value",
    "SmtpUser": "placeholder_value",
    "SmtpPass": "placeholder_value"
  },
  "PasswordHasherSettings": {
    "SaltSize": "placeholder_value",
    "KeySize": "placeholder_value",
    "MemorySize": "placeholder_value",
    "Iterations": "placeholder_value",
    "DegreeOfParallelism": "placeholder_value",
    "Delimiter": "placeholder_value"
  }
}